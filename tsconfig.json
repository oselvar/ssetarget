{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "module": "esnext",
    "noEmit": true,
    "target": "esnext",
    "types": ["node", "@cloudflare/workers-types"],
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true
  },
  "include": ["src/**/*.ts"],
  // src/examples is an end-to-end Worker with its own tsconfig that uses
  // wrangler-generated runtime types. The library must not depend on types
  // generated from the example, so it is excluded here.
  "exclude": ["src/examples"]
}
