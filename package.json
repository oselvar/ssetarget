{
  "name": "@oselvar/ssetarget",
  "version": "4.0.2",
  "description": "Dispatch Server-Sent Events",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cloudflare",
    "workflows",
    "events",
    "sse"
  ],
  "homepage": "https://github.com/oselvar/ssetarget#readme",
  "bugs": {
    "url": "https://github.com/oselvar/ssetarget/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/oselvar/ssetarget.git"
  },
  "license": "MIT",
  "author": "Aslak Hellesøy",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "import": "./dist/redis/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "import": "./dist/workflows/index.js"
    },
    "./workflows/cloudflare": {
      "types": "./dist/workflows/cloudflare/index.d.ts",
      "import": "./dist/workflows/cloudflare/index.js"
    },
    "./workflows/cloudflare/sse": {
      "types": "./dist/workflows/cloudflare/sse/index.d.ts",
      "import": "./dist/workflows/cloudflare/sse/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "start": "wrangler dev --port 9875",
    "fix": "tsc && oxfmt && oxlint --fix .",
    "types": "wrangler types src/examples/worker-configuration.d.ts",
    "check:examples": "pnpm run types && tsc -p src/examples/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "release": "release-it",
    "upgrade": "npm-check-updates --upgrade --deep"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260615.1",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/node": "25.9.3",
    "@vitest/coverage-v8": "4.1.9",
    "eventsource-client": "1.2.0",
    "hono": "4.12.25",
    "ioredis": "5.11.1",
    "npm-check-updates": "22.2.3",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "release-it": "20.2.0",
    "typescript": "5.8.3",
    "vitest": "4.1.9",
    "wrangler": "4.100.0"
  },
  "peerDependencies": {
    "hono": "^4.8.10",
    "ioredis": "^5.7.0"
  }
}
